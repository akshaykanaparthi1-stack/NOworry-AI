{
  "manifest_version": 3,
  "name": "NoWorry AI — Revenue Recovery Agent",
  "version": "1.0.0",
  "description": "Autonomous AI agent extension for revenue leakage detection, ML recovery prediction, and simulated recovery actions.",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_popup": "dist/src/popup/index.html",
    "default_title": "NoWorry AI — Revenue Recovery Agent"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://noworry-ai.vercel.app/demo-merchant*",
        "https://*.vercel.app/demo-merchant*",
        "http://localhost:3000/demo-merchant*",
        "http://127.0.0.1:3000/demo-merchant*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://noworry-ai-api.onrender.com/*",
    "https://*.onrender.com/*",
    "https://noworry-ai.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ]
}
