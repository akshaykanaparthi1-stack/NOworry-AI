# ---------------------------------------------------------------------
# 1. DEVELOPMENT ENVIRONMENT SETTINGS (Localhost Sandbox)
# ---------------------------------------------------------------------
# PORT=8000
# HOST=127.0.0.1
# ENVIRONMENT=development
# DEBUG=true
# DATABASE_URL=sqlite:///./noworry_ai.db
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------
# 2. PRODUCTION ENVIRONMENT SETTINGS (Deployed Cloud / Supabase)
# ---------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL / Supabase Connection Pool URI
DATABASE_URL=postgresql://postgres.qtulrhuecnrlntbgusqt:[YOUR-SUPABASE-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Auth Credentials
SUPABASE_URL=https://qtulrhuecnrlntbgusqt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_t8wQQT4fBnxTibjBoOY91g_slUA0cQT
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_JWKS_URL=https://qtulrhuecnrlntbgusqt.supabase.co/auth/v1/.well-known/jwks.json

# CORS Configuration (Set your production frontend domain here)
ALLOWED_ORIGINS=https://noworry-ai.vercel.app,http://localhost:3000

# AI / LLM Configuration (Options: deterministic | gemini | openai)
LLM_PROVIDER=deterministic
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ML Model Configuration
MODEL_DIR=ml/models
SYNTHETIC_DATA_SIZE=50000

# Frontend Configuration (Next.js Client - Set your production backend domain)
NEXT_PUBLIC_API_URL=https://api.noworry.ai/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://qtulrhuecnrlntbgusqt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_t8wQQT4fBnxTibjBoOY91g_slUA0cQT
