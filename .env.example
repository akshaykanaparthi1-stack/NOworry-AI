# =====================================================================
# NoWorry AI — Autonomous Revenue Recovery Agent Environment Setup
# =====================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Database Configuration
# Default: Local SQLite database for zero-dependency development
DATABASE_URL=sqlite:///./noworry_ai.db

# Production Supabase / PostgreSQL Connection Example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-REF].supabase.co:5432/postgres

# CORS Configuration (Comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI / LLM Configuration
# Options: deterministic | gemini | openai
LLM_PROVIDER=deterministic
GEMINI_API_KEY=
OPENAI_API_KEY=

# ML Model Configuration
MODEL_DIR=ml/models
SYNTHETIC_DATA_SIZE=50000

# Frontend Configuration (Next.js Client)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
